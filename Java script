
import express from "express";
import OpenAI from "openai";
import path from "node:path";
import { fileURLToPath } from "node:url";

const app = express();
const PORT = process.env.PORT || 3000;

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

app.use(express.json({ limit: "20kb" }));

// Exibe a interface da IA Sim
app.use(express.static(__dirname));

// Verifica se o servidor está funcionando
app.get("/api/status", (req, res) => {
  res.json({ online: true, nome: "IA Sim" });
});

// Recebe mensagens e consulta a OpenAI
app.post("/api/chat", async (req, res) => {
  try {
    const message = req.body?.message;

    if (typeof message !== "string" || !message.trim()) {
      return res.status(400).json({
        error: "Digite uma mensagem."
      });
    }

    if (message.length > 8000) {
      return res.status(400).json({
        error: "A mensagem é muito longa."
      });
    }

    if (!process.env.OPENAI_API_KEY) {
      return res.status(503).json({
        error: "A chave da IA ainda não foi configurada."
      });
    }

    const openai = new OpenAI({
      apiKey: process.env.OPENAI_API_KEY
    });

    const response = await openai.responses.create({
      model: "gpt-4.1-mini",
      instructions:
        "Você é a IA Sim, uma assistente útil, clara e educada. Responda em português quando o usuário falar português.",
      input: message.trim(),
      max_output_tokens: 800
    });

    res.json({
      reply: response.output_text
    });
  } catch (error) {
    console.error("Erro na API:", error.message);

    res.status(500).json({
      error: "Não foi possível gerar uma resposta. Tente novamente."
    });
  }
});

app.listen(PORT, "0.0.0.0", () => {
  console.log(`IA Sim iniciada na porta ${PORT}`);
});
